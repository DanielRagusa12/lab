#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
user: ${username}
users:
  - default
  - name: ${username}
    groups: sudo
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh_authorized_keys:
      - ${ssh_key}

package_update: true
packages:
  - qemu-guest-agent
  - nfs-common

runcmd:
  - systemctl enable --now qemu-guest-agent