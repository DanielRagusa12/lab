services:
  mc:
    image: itzg/minecraft-server:java21-graalvm
    container_name: minecraft-java
    ports:
      - "25565:25565"
    environment:
      EULA: "TRUE"
      TYPE: "NEOFORGE"
      VERSION: "1.21.1"
      NEOFORGE_VERSION: "21.1.65"
      MEMORY: "8G"
    volumes:
      - ./data:/data
    restart: unless-stopped