services:
  mc:
    image: itzg/minecraft-server:java21-jdk
    container_name: minecraft-java
    ports:
      - "25565:25565"
      - "25575:25575"
    environment:
      EULA: "TRUE"
      # CUSTOM allows us to use a script instead of the auto-installer
      TYPE: "CUSTOM"
      # Point to the shell script generated by the manual installer
      CUSTOM_SERVER: "/data/run.sh"
      # We tell the image to skip trying to download forge/neoforge binaries
      SKIP_JAR_DOWNLOAD: "true"
      MEMORY: "16G"
      RCON_PASSWORD: "{{ rcon_password }}"
      ENABLE_COMMAND_BLOCK: "true"
    volumes:
      - ./data:/data
    restart: unless-stopped